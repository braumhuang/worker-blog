{
  "name": "worker-blog",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:schema:local": "wrangler d1 execute BLOG_DB --local --file=./schema.sql",
    "db:schema:remote": "wrangler d1 execute BLOG_DB --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute BLOG_DB --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute BLOG_DB --remote --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260000.0",
    "typescript": "^6.0.0",
    "wrangler": "4.110.0"
  }
}
